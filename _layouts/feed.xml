---
{%- include locale.html -%}
<?xml version="1.0" encoding="UTF-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ current_lang }}">
  <title>{{ t.journal.title | append: ' · ' | append: t.author_name | xml_escape }}</title>
  <subtitle>{{ t.journal.description | xml_escape }}</subtitle>
  <link href="{{ journal_url | absolute_url | xml_escape }}"/>
  <link href="{{ feed_url | absolute_url | xml_escape }}" rel="self" type="application/atom+xml"/>
  <id>{{ feed_url | absolute_url | xml_escape }}</id>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <author><name>{{ t.author_name | xml_escape }}</name></author>
  {% for post in locale_posts limit:20 %}<entry>
    <title>{{ post.title | xml_escape }}</title><link href="{{ post.url | absolute_url | xml_escape }}"/>
    <id>{{ post.url | absolute_url | xml_escape }}</id><published>{{ post.date | date_to_xmlschema }}</published><updated>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</updated>
    <summary>{{ post.description | xml_escape }}</summary><content type="html">{{ post.content | xml_escape }}</content>
  </entry>{% endfor %}
</feed>
